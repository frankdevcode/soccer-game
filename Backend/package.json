{
  "name": "soccer-game-backend",
  "version": "0.1.0",
  "description": "Backend API for Soccer-Game - Professional 3D Futsal Videogame",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js --exec node --experimental-modules",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "build": "tsc",
    "deploy": "npm run build && npm start"
  },
  "keywords": [
    "soccer",
    "futsal",
    "videogame",
    "3d",
    "api",
    "rest"
  ],
  "author": "Frank Dev Code",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "socket.io": "^4.7.1",
    "ws": "^8.14.2",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "mongoose": "^7.7.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "express-validator": "^7.0.0",
    "uuid": "^9.0.1",
    "pino": "^8.16.2",
    "pino-http": "^8.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "@types/node": "^20.8.0",
    "@types/express": "^4.17.20",
    "eslint": "^8.51.0",
    "prettier": "^3.1.0",
    "jest": "^29.7.0",
    "@testing-library/jest-dom": "^6.1.4",
    "supertest": "^6.3.3",
    "typescript": "^5.2.2"
  }
}
